// Cloudflare Workers deploy of the React app as static assets (no server code).
// `npx wrangler deploy` builds web/ for the site root and uploads web/dist.
// The API (FastAPI + MariaDB) is not part of this deploy: /api must be served elsewhere.
{
  "name": "junction26",
  "compatibility_date": "2026-11-01",
  "build": {
    // --base=/ : the repo's vite config builds for /contested/ (where FastAPI serves the app).
    "command": "cd web && npm ci && npm run build -- --base=/"
  },
  "assets": {
    "directory": "./web/dist",
    "not_found_handling": "single-page-application"
  }
}
