# Copy to .env (read by common/db.py, used by every script, the API and start.py). Never commit .env.
# Defaults in common/db.py: 127.0.0.1:3306, root/root, wiki.
DB_HOST=127.0.0.1
DB_PORT=3307             # our local MariaDB 13 Windows service (3306 is MySQL 8 on that PC)
DB_USER=root
DB_PASSWORD=root
DB_NAME=wiki
DATASET=demo             # sentence loader preset: demo | small | medium | large  (see docs/decisions.md)

# Gemma (scoring/). Any OpenAI-compatible endpoint: vLLM on Verda, Ollama, Featherless.
SCORING_URL=             # e.g. http://<verda-ip>:8000/v1
GEMMA_MODEL=             # e.g. google/gemma-3-12b-it
SCORING_API_KEY=         # only for hosted endpoints
HF_TOKEN=                # for downloading Gemma weights on Verda
